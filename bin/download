#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

source "${plugin_dir}/lib/utils.bash"

mkdir -p "$ASDF_DOWNLOAD_PATH"

release_file="${ASDF_DOWNLOAD_PATH}/$(release_filename "$ASDF_INSTALL_VERSION")"

# Download the release archive to the download directory.
download_release "$ASDF_INSTALL_VERSION" "$release_file"

# Extract contents into the download directory. The pulumi archive has a single
# top-level "pulumi/" directory, so strip it to land the binaries directly.
if [[ $release_file == *.zip ]]; then
  unzip -qo "$release_file" -d "$ASDF_DOWNLOAD_PATH" || fail "Could not extract $release_file"
  # The zip nests everything under "pulumi/"; flatten it.
  if [ -d "${ASDF_DOWNLOAD_PATH}/pulumi/bin" ]; then
    mv "${ASDF_DOWNLOAD_PATH}/pulumi/bin/"* "$ASDF_DOWNLOAD_PATH"
  else
    mv "${ASDF_DOWNLOAD_PATH}/pulumi/"* "$ASDF_DOWNLOAD_PATH"
  fi
  rm -rf "${ASDF_DOWNLOAD_PATH}/pulumi"
else
  tar -xzf "$release_file" -C "$ASDF_DOWNLOAD_PATH" --strip-components=1 || fail "Could not extract $release_file"
fi

# Remove the downloaded archive; it is no longer needed.
rm "$release_file"
